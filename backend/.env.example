# Copy to backend/.env
NODE_ENV=development
PORT=4000
DATABASE_URL="file:./dev.db"
# Long random string; generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
WEB_ORIGIN=http://localhost:5173
# Demo mode seeds synthetic patients and these accounts (refused when NODE_ENV=production):
#   pharm1 / demo1234  (เภสัชกร)
#   super1 / demo1234  (หัวหน้าเภสัชกร)
#   admin1 / demo1234  (ผู้ดูแลระบบ: no patient data)
DEMO_MODE=true
